# API própria do Barber Hub — nunca envie o arquivo .env real ao GitHub.
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Preferidos em projetos atuais do Supabase
SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXEMPLO
SUPABASE_SECRET_KEY=sb_secret_EXEMPLO

# Compatibilidade com chaves legadas (use somente se o projeto ainda depender delas)
# SUPABASE_ANON_KEY=SUA_CHAVE_ANON
# SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE

# Opcional: origens extras para previews e futuro aplicativo Capacitor.
BARBER_HUB_ALLOWED_ORIGINS=https://barberhuboficial.vercel.app

# Endereço para onde o e-mail de recuperação deve levar o usuário.
BARBER_HUB_PASSWORD_REDIRECT_URL=https://barberhuboficial.vercel.app/html/redefinir-senha.html

# Site key PUBLICA do Cloudflare Turnstile. A secret fica apenas no Supabase Auth.
BARBER_HUB_TURNSTILE_SITE_KEY=0x4AAAAAAA_EXEMPLO_PUBLICO

# Chave pública usada para registrar este navegador em avisos Web Push.
BARBER_HUB_VAPID_PUBLIC_KEY=CHAVE_PUBLICA_VAPID_EXEMPLO

# O worker externo de entrega também precisa destes valores somente no servidor:
# BARBER_HUB_VAPID_PRIVATE_KEY=CHAVE_PRIVADA_VAPID_EXEMPLO
# BARBER_HUB_VAPID_SUBJECT=mailto:suporte@seu-dominio.com
# Na Vercel, CRON_SECRET é enviado automaticamente como Bearer. Use ao menos
# 16 caracteres aleatórios. BARBER_HUB_JOBS_SECRET continua aceito para um
# agendador externo que envie o cabeçalho X-Jobs-Secret.
# CRON_SECRET=GERE_UM_VALOR_ALEATORIO_DE_32_BYTES
# BARBER_HUB_JOBS_SECRET=GERE_OUTRO_VALOR_ALEATORIO_DE_32_BYTES
